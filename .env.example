# Postgres. Locally: `docker compose up -d` and keep these values.
# On Vercel: DATABASE_URL = Neon pooled connection string (host has "-pooler"),
#            DIRECT_URL   = Neon direct connection string (used for migrations).
DATABASE_URL="postgresql://school:school@localhost:5432/school"
DIRECT_URL="postgresql://school:school@localhost:5432/school"

# Secret used to sign sessions and pickup passes. Generate with: openssl rand -base64 48
TOKEN_SECRET="change-me-to-a-long-random-string"

# Public URL of the app, used in pickup-pass QR codes and invitation slips.
BASE_URL="http://localhost:3000"

# Vercel Blob token for pickup-person photos. Leave empty locally to store photos in ./storage.
# On Vercel it is added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=""

# SQLite file (relative to prisma/). Switch the provider in schema.prisma to use Postgres.
DATABASE_URL="file:./dev.db"

# Secret used to sign sessions and pickup passes. Use a long random value.
TOKEN_SECRET="change-me-to-a-long-random-string"

# Public URL of the app, used in pickup-pass QR codes and invitation slips.
BASE_URL="http://localhost:3000"
